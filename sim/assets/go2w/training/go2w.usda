#usda 1.0
(
    defaultPrim = "Go2W"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Go2W" (
    prepend references = @/home/joy/桌面/RobotDog/sim/assets/go2w/go2w_description/go2w_description.usda@
    variants = {
        string Physics = "physx"
    }
