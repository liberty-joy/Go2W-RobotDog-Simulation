#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "go2w_description"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "go2w_description" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </go2w_description/Physics/Head_upper_joint>,
        </go2w_description/Physics/FL_hip_joint>,
        </go2w_description/Physics/FR_hip_joint>,
        </go2w_description/Physics/RL_hip_joint>,
        </go2w_description/Physics/RR_hip_joint>,
        </go2w_description/Physics/Head_lower_joint>,
        </go2w_description/Physics/FL_thigh_joint>,
        </go2w_description/Physics/FL_calf_joint>,
        </go2w_description/Physics/FL_calflower_joint>,
        </go2w_description/Physics/FL_foot_motor_joint>,
        </go2w_description/Physics/FL_foot_joint>,
        </go2w_description/Physics/FL_calflower1_joint>,
        </go2w_description/Physics/FR_thigh_joint>,
        </go2w_description/Physics/FR_calf_joint>,
        </go2w_description/Physics/FR_calflower_joint>,
        </go2w_description/Physics/FR_foot_motor_joint>,
        </go2w_description/Physics/FR_foot_joint>,
        </go2w_description/Physics/FR_calflower1_joint>,
        </go2w_description/Physics/RL_thigh_joint>,
        </go2w_description/Physics/RL_calf_joint>,
        </go2w_description/Physics/RL_calflower_joint>,
        </go2w_description/Physics/RL_foot_motor_joint>,
        </go2w_description/Physics/RL_foot_joint>,
        </go2w_description/Physics/RL_calflower1_joint>,
        </go2w_description/Physics/RR_thigh_joint>,
        </go2w_description/Physics/RR_calf_joint>,
        </go2w_description/Physics/RR_calflower_joint>,
        </go2w_description/Physics/RR_foot_motor_joint>,
        </go2w_description/Physics/RR_foot_joint>,
        </go2w_description/Physics/RR_calflower1_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </go2w_description/Geometry/base>,
        </go2w_description/Geometry/base/Head_upper>,
        </go2w_description/Geometry/base/Head_upper/Head_lower>,
        </go2w_description/Geometry/base/FL_hip>,
        </go2w_description/Geometry/base/FL_hip/FL_thigh>,
        </go2w_description/Geometry/base/FL_hip/FL_thigh/FL_calf>,
        </go2w_description/Geometry/base/FL_hip/FL_thigh/FL_calf/FL_calflower>,
        </go2w_description/Geometry/base/FL_hip/FL_thigh/FL_calf/FL_calflower/FL_calflower1>,
        </go2w_description/Geometry/base/FL_hip/FL_thigh/FL_calf/FL_foot_motor>,
        </go2w_description/Geometry/base/FL_hip/FL_thigh/FL_calf/FL_foot>,
        </go2w_description/Geometry/base/FR_hip>,
        </go2w_description/Geometry/base/FR_hip/FR_thigh>,
        </go2w_description/Geometry/base/FR_hip/FR_thigh/FR_calf>,
        </go2w_description/Geometry/base/FR_hip/FR_thigh/FR_calf/FR_calflower>,
        </go2w_description/Geometry/base/FR_hip/FR_thigh/FR_calf/FR_calflower/FR_calflower1>,
        </go2w_description/Geometry/base/FR_hip/FR_thigh/FR_calf/FR_foot_motor>,
        </go2w_description/Geometry/base/FR_hip/FR_thigh/FR_calf/FR_foot>,
        </go2w_description/Geometry/base/RL_hip>,
        </go2w_description/Geometry/base/RL_hip/RL_thigh>,
        </go2w_description/Geometry/base/RL_hip/RL_thigh/RL_calf>,
        </go2w_description/Geometry/base/RL_hip/RL_thigh/RL_calf/RL_calflower>,
        </go2w_description/Geometry/base/RL_hip/RL_thigh/RL_calf/RL_calflower/RL_calflower1>,
        </go2w_description/Geometry/base/RL_hip/RL_thigh/RL_calf/RL_foot_motor>,
        </go2w_description/Geometry/base/RL_hip/RL_thigh/RL_calf/RL_foot>,
        </go2w_description/Geometry/base/RR_hip>,
        </go2w_description/Geometry/base/RR_hip/RR_thigh>,
        </go2w_description/Geometry/base/RR_hip/RR_thigh/RR_calf>,
        </go2w_description/Geometry/base/RR_hip/RR_thigh/RR_calf/RR_calflower>,
        </go2w_description/Geometry/base/RR_hip/RR_thigh/RR_calf/RR_calflower/RR_calflower1>,
        </go2w_description/Geometry/base/RR_hip/RR_thigh/RR_calf/RR_foot_motor>,
        </go2w_description/Geometry/base/RR_hip/RR_thigh/RR_calf/RR_foot>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "FL_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
