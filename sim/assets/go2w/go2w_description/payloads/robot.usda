                        )
                        {
                        }
                    }
                }
            }

            over "RR_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "RR_thigh" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "RR_calf" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "RR_foot" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }

                        over "RR_calflower" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "RR_calflower1" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                            }
                        }

                        over "RR_foot_motor" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "Head_upper" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "Head_lower" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "imu" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
            }

            over "radar" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "Head_upper_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
