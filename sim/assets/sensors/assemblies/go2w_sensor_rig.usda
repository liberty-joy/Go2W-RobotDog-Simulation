#usda 1.0
(
    defaultPrim = "SensorRig"
    metersPerUnit = 1
    upAxis = "Z"
    customLayerData = {
        string assetRole = "Go2-W sensor rig assembly; appearance and measurement origins are deliberately separate"
        string authenticity = "Gemini335L vendor USD is an Isaac 6.2 certified asset; OS0 appearance is an Isaac 6.2 REV6/REV7 family asset; Measurement is a parameterized functional proxy, not a REV8 certified digital twin"
        string collisionPolicy = "No assembly collision; sensor rig inherits the Go2-W base motion"
    }
)

def Xform "SensorRig" (
    kind = "assembly"
)
{
    custom string rig:coordinateConvention = "+X forward, +Y left, +Z up"
    custom string rig:massPolicy = "visual and measurement-only; no independent mass or rigid body"

    def Xform "Appearance" (
        kind = "group"
    )
    {
        def Xform "Gemini335LMount"
        {
            double3 xformOp:translate = (0.30, 0, 0.095)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Xform "Gemini335L" (
                prepend references = @../vendor/nvidia_isaac_6_2/Orbbec/Gemini335L/orbbec_gemini_335L.usd@
            )
            {
                # The vendor asset root carries a ~0.99 m catalog/demo placement.
                # Override placement only; preserve its vendor-authored orientation and scale.
                quatd xformOp:orient = (6.123233995736766e-17, -4.329780281177467e-17, -0.7071067811865476, -0.7071067811865476)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }

        def Xform "OS0Mount"
        {
            double3 xformOp:translate = (0, 0, 0.122)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Xform "OS0_REV7_Appearance" (
                prepend references = @../vendor/nvidia_isaac_6_2/Ouster/OS0/OS0.usd@
                variants = {
                    string sensor = "OS0_REV7_128ch10hz512res"
                }
                prepend variantSets = "sensor"
            )
            {
                over "sensor" (
                    active = false
                )
                {
                }
            }
        }

        def Cube "MountPlate"
        {
            double size = 1
            color3f[] primvars:displayColor = [(0.12, 0.12, 0.14)]
            double3 xformOp:scale = (0.14, 0.09, 0.006)
            double3 xformOp:translate = (0.02, 0, 0.115)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "Measurement" (
        kind = "group"
    )
    {
        custom string measurement:cameraModel = "ideal pinhole RGB proxy; no IR projector, rolling shutter, stereo matching or SDK depth"
        custom string measurement:lidarModel = "64 uniform elevation emitters, 512 columns, 10 Hz, 0.5-20 m; REV8 FOV-class proxy"
        custom double measurement:stereoBaselineM = 0.095
        custom string measurement:sourceConfig = "../../../../configs/sensors/stage2_rig.json"

        def Xform "LeftOpticalOrigin"
        {
            double3 xformOp:translate = (0.365, 0.0475, 0.095)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "RightOpticalOrigin"
        {
            double3 xformOp:translate = (0.365, -0.0475, 0.095)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "LidarOpticalOrigin"
        {
            double3 xformOp:translate = (0, 0, 0.200)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "ImuOrigin"
        {
            double3 xformOp:translate = (0, 0, 0.205)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
